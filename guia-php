                <h3>2. Tabla del 2 con WHILE</h3>
                <div class="table-container">
                    <table class="multiplication-table">
                        <?php
                        $f = 2;
                        $contador = 1;
                        while ($f <= 20) {
                            echo "<tr>";
                            echo "<td>2 × $contador</td>";
                            echo "<td>=</td>";
                            echo "<td><strong>$f</strong></td>";
                            echo "</tr>";
                            $f = $f + 2;
                            $contador++;
                        }
                        ?>
                    </table>
                </div>
                
                <h3>3. Tabla del 2 con DO/WHILE</h3>
                <div class="table-container">
                    <table class="multiplication-table">
                        <?php
                        $f = 2;
                        $contador = 1;
                        do {
                            echo "<tr>";
                            echo "<td>2 × $contador</td>";
                            echo "<td>=</td>";
                            echo "<td><strong>$f</strong></td>";
                            echo "</tr>";
                            $f = $f + 2;
                            $contador++;
                        } while ($f <= 20);
                        ?>
                    </table>
                </div>
                
                <div class="code-block">
                    <strong>Código FOR:</strong><br>
                    for ($f = 2; $f <= 20; $f = $f + 2) {<br>
                    &nbsp;&nbsp;echo "2 × " . ($f / 2) . " = $f";<br>
                    }<br><br>
                    <strong>Código WHILE:</strong><br>
                    while ($f <= 20) {<br>
                    &nbsp;&nbsp;echo "2 × $contador = $f";<br>
                    &nbsp;&nbsp;$f = $f + 2;<br>
                    &nbsp;&nbsp;$contador++;<br>
                    }<br><br>
                    <strong>Código DO/WHILE:</strong><br>
                    do {<br>
                    &nbsp;&nbsp;echo "2 × $contador = $f";<br>
                    &nbsp;&nbsp;$f = $f + 2;<br>
                    &nbsp;&nbsp;$contador++;<br>
                    } while ($f <= 20);
                </div>
